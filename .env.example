# ─────────────────────────────────────────────────────────────────────────────
# JobUndo — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,django

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=jobundo
POSTGRES_USER=jobundo
POSTGRES_PASSWORD=changeme

# Django uses psycopg2 (sync)
DATABASE_URL=postgresql://jobundo:changeme@postgres:5432/jobundo

# FastAPI uses asyncpg (async) for health checks
ASYNC_DATABASE_URL=postgresql+asyncpg://jobundo:changeme@postgres:5432/jobundo

# FastAPI uses psycopg2 (sync) for langchain PGVector (Phase 5)
SYNC_DATABASE_URL=postgresql+psycopg2://jobundo:changeme@postgres:5432/jobundo

# ── Internal Service Auth ─────────────────────────────────────────────────────
# Django sends this header to FastAPI. Keep it secret.
INTERNAL_API_SECRET=changeme-internal-secret-min-32-chars

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434

# Set your chosen model here when ready.
# Options: llama3.2:1b | llama3.2:3b | llama3.2:8b | mistral:7b | etc.
LLM_MODEL=llama3.2:3b

# Embedding model (lightweight, runs fast on CPU)
EMBED_MODEL=nomic-embed-text

# ── Service URLs (inter-container) ───────────────────────────────────────────
FASTAPI_URL=http://fastapi:8001

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000
